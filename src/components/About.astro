---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);
---

<section class="about px-6 md:px-10 py-32 md:py-48 border-t border-border">
  <div class="grid md:grid-cols-12 gap-8 md:gap-12">
    <div class="md:col-span-3">
      <span class="micro text-muted" data-reveal
        >{t.about.index} — {t.about.label}</span
      >
    </div>

    <div class="md:col-span-9">
      <h2
        class="font-display text-[clamp(2rem,5.5vw,4.5rem)] leading-[0.95] uppercase max-w-4xl"
        data-reveal-lines
      >
        <span class="mask-line"
          ><span class="reveal-line block">{t.about.title}</span></span
        >
      </h2>

      <p
        class="mt-8 md:mt-12 max-w-2xl text-muted text-base md:text-lg leading-relaxed"
        data-reveal
      >
        {t.about.text}
      </p>

      <ul
        class="mt-12 md:mt-16 flex flex-wrap gap-x-8 gap-y-3 micro text-muted"
        data-reveal-stagger
      >
        {
          t.about.services.map((service, i) => (
            <li class="flex items-center gap-3">
              <span
                class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-accent" : "bg-accent2"}`}
              />
              {service}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
