---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);
---

<footer class="footer px-6 md:px-10 pt-32 md:pt-48 pb-8 border-t border-border">
  <div class="grid md:grid-cols-12 gap-8 md:gap-12 mb-24 md:mb-32">
    <div class="md:col-span-3">
      <span class="micro text-muted" data-reveal>{t.footer.label}</span>
    </div>

    <div class="md:col-span-9">
      <h2
        class="font-display text-[clamp(2.5rem,7vw,6rem)] leading-[0.9] uppercase mb-12 md:mb-16"
        data-reveal-lines
      >
        <span class="mask-line"
          ><span class="reveal-line block">{t.footer.title}</span></span
        >
      </h2>

      <a
        href={`mailto:${t.footer.email}`}
        class="inline-block text-xl md:text-3xl hover:text-accent transition-colors"
        data-reveal
      >
        {t.footer.email}
      </a>
    </div>
  </div>

  <div class="grid md:grid-cols-12 gap-8 md:gap-12 mb-16 md:mb-24">
    <div class="md:col-span-3">
      <span class="micro text-muted" data-reveal>{t.footer.socialsLabel}</span>
    </div>
    <div
      class="md:col-span-9 flex flex-wrap gap-x-8 gap-y-3"
      data-reveal-stagger
    >
      {
        t.footer.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="micro hover:text-accent transition-colors"
          >
            {social.label} ↗
          </a>
        ))
      }
    </div>
  </div>

  <div
    class="flex flex-wrap justify-between items-center gap-4 pt-8 border-t border-border micro text-muted"
    data-reveal
  >
    <span>
      OTTRO<span class="text-accent">.</span>studio
    </span>

    <div class="flex flex-wrap gap-x-6 gap-y-2" data-reveal-stagger>
      <span class="flex items-center gap-3">
        <span class="w-1 h-1 rounded-full bg-accent"></span>
        Astro
      </span>
      <span class="flex items-center gap-3">
        <span class="w-1 h-1 rounded-full bg-accent2"></span>
        GSAP
      </span>
      <span class="flex items-center gap-3">
        <span class="w-1 h-1 rounded-full bg-accent"></span>
        {t.footer.location}
      </span>
      <span class="flex items-center gap-3">
        <span class="w-1 h-1 rounded-full bg-accent2"></span>
        {t.footer.year}
      </span>
    </div>

    <span>© {t.footer.year}</span>
  </div>
</footer>
