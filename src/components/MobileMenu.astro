---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);

const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(es|en)/, "") || "/";

const esUrl = `/es${pathWithoutLang === "/" ? "" : pathWithoutLang}`;
const enUrl = `/en${pathWithoutLang === "/" ? "" : pathWithoutLang}`;
---

<div
  class="mobile-menu fixed inset-0 z-[150] bg-bg flex flex-col justify-between px-6 py-6 md:hidden"
  data-mobile-menu
  aria-hidden="true"
>
  {/* Header del overlay (espacio para el nav fijo) */}
  <div class="h-16 shrink-0"></div>

  {/* Links principales */}
  <nav class="flex-1 flex flex-col justify-center gap-2">
    <a href={`/${lang}/work`} class="mobile-menu-link block" data-menu-link>
      <span class="mask-line">
        <span
          class="menu-line block font-display text-[clamp(3rem,14vw,7rem)] leading-none uppercase"
        >
          {t.nav.work}
        </span>
      </span>
    </a>

    <a href={`/${lang}/about`} class="mobile-menu-link block" data-menu-link>
      <span class="mask-line">
        <span
          class="menu-line block font-display text-[clamp(3rem,14vw,7rem)] leading-none uppercase"
        >
          {t.nav.about}
        </span>
      </span>
    </a>
  </nav>

  {/* Footer del overlay */}
  <div class="shrink-0">
    <div class="menu-footer-line h-px w-full bg-accent2 mb-6"></div>

    <div
      class="flex flex-wrap justify-between items-end gap-4 micro text-muted"
    >
      <div class="flex gap-3">
        <a href={esUrl} class:text-accent={lang === "es"}>ES</a>
        <span class="text-faint">/</span>
        <a href={enUrl} class:text-accent={lang === "en"}>EN</a>
      </div>
      <a
        href={`mailto:${t.footer.email}`}
        class="hover:text-accent transition-colors"
      >
        {t.footer.email}
      </a>
    </div>
  </div>
</div>
