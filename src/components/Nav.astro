---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);

// Obtener la ruta actual sin el prefijo del idioma
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(es|en)/, "") || "/";

// Construir las URLs para cada idioma manteniendo la ruta
const esUrl = `/es${pathWithoutLang === "/" ? "" : pathWithoutLang}`;
const enUrl = `/en${pathWithoutLang === "/" ? "" : pathWithoutLang}`;
---

<header
  class="fixed top-0 left-0 w-full z-160 px-6 md:px-10 py-6 flex justify-between items-center mix-blend-difference"
>
  <a href={`/${lang}`} class="font-display text-xl tracking-tight text-text">
    OTTRO<span class="text-accent">.</span>studio
  </a>

  {/* Nav desktop */}
  <nav class="hidden md:flex items-center gap-8 micro text-muted">
    <a href={`/${lang}/work`} class="hover:text-text transition-colors"
      >{t.nav.work}</a
    >
    <a href={`/${lang}/about`} class="hover:text-text transition-colors"
      >{t.nav.about}</a
    >
  </nav>

  {/* Language switcher desktop */}
  <div class="hidden md:flex items-center gap-3 micro">
    <a href={esUrl} class:text-accent={lang === "es"}>ES</a>
    <span class="text-faint">/</span>
    <a href={enUrl} class:text-accent={lang === "en"}>EN</a>
  </div>

  {/* Botón hamburguesa móvil */}
  <button
    type="button"
    class="md:hidden relative w-8 h-8 flex flex-col justify-center items-end gap-1.5"
    data-menu-toggle
    aria-label="Menú"
    aria-expanded="false"
  >
    <span
      class="hamburger-line block w-7 h-px bg-accent origin-center transition-none"
    ></span>
    <span
      class="hamburger-line block w-5 h-px bg-accent origin-center transition-none"
    ></span>
  </button>
</header>
