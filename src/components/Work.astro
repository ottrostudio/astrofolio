---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);
---

<section class="work px-6 md:px-10 py-32 md:py-48">
  <div class="flex items-end justify-between mb-16 md:mb-24">
    <div class="flex items-baseline gap-6">
      <span class="micro text-muted" data-reveal
        >{t.work.index} — {t.work.label}</span
      >
      <h2
        class="font-display text-[length:var(--text-h2)] leading-none uppercase"
        data-reveal-lines
      >
        <span class="mask-line"
          ><span class="reveal-line block">{t.work.title}</span></span
        >
      </h2>
    </div>
    <a
      href={`/${lang}/work`}
      class="micro text-muted hover:text-accent transition-colors hidden md:inline-block"
      data-reveal
    >
      {t.work.seeAll} →
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
    {
      t.work.projects.map((project, i) => (
        <a
          href={`/${lang}/work/${project.slug}`}
          class="project-card group block"
          data-reveal
        >
          <div class="aspect-[4/3] bg-elev rounded-sm overflow-hidden relative">
            <div
              class="absolute inset-[-10%] bg-gradient-to-br from-accent/15 via-transparent to-accent2/15"
              data-parallax
            />
            <div class="absolute inset-0 flex items-center justify-center p-8">
              <span class="font-display text-[clamp(1.5rem,4vw,3.5rem)] leading-none text-text/15 uppercase text-center">
                {project.name}
              </span>
            </div>
            <div class="absolute top-4 right-4 micro text-muted">
              {String(i + 1).padStart(2, "0")}
            </div>
          </div>

          <div class="mt-4 flex items-baseline justify-between gap-4">
            <h3 class="text-lg md:text-xl group-hover:text-accent transition-colors">
              {project.name}
            </h3>
            <span class="micro text-muted shrink-0">{project.year}</span>
          </div>
          <p class="micro text-faint mt-1">{project.category}</p>
        </a>
      ))
    }
  </div>

  <div class="mt-16 md:hidden" data-reveal>
    <a
      href={`/${lang}/work`}
      class="micro text-muted hover:text-accent transition-colors"
    >
      {t.work.seeAll} →
    </a>
  </div>
</section>
