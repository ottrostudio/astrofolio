---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);

// Solo mostramos los primeros 3 en la home
const featured = t.work.projects.slice(0, 3);
---

<section class="work-full">
  {/* Header de la sección */}
  <div class="px-6 md:px-10 pt-32 md:pt-48 pb-16 md:pb-24">
    <div class="flex items-baseline gap-6 mb-8">
      <span class="micro text-muted" data-reveal>
        {t.work.index} — {t.work.label}
      </span>
    </div>
    <h2
      class="font-display text-[clamp(3rem,9vw,8rem)] leading-none uppercase"
      data-reveal-lines
    >
      <span class="mask-line"
        ><span class="reveal-line block">{t.work.title}</span></span
      >
    </h2>
  </div>

  {/* Proyectos */}
  {
    featured.map((project, i) => {
      const isEven = i % 2 === 0;
      return (
        <article
          class="project-full px-6 md:px-10 py-24 md:py-32"
          data-project
          data-project-index={i}
        >
          <div class="project-inner grid md:grid-cols-12 gap-8 md:gap-16 items-center">
            {/* Bloque imagen */}
            <div
              class={`md:col-span-7 ${isEven ? "md:order-1" : "md:order-2"}`}
            >
              <a
                href={`/${lang}/work/${project.slug}`}
                class="block relative aspect-[4/3] overflow-hidden rounded-sm group"
              >
                {/* Fondo gradiente (placeholder) */}
                <div class="project-image absolute inset-[-10%] bg-gradient-to-br from-accent/25 via-transparent to-accent2/25" />

                {/* Nombre gigante translúcido dentro */}
                <div class="absolute inset-0 flex items-center justify-center p-8">
                  <span class="font-display text-[clamp(2rem,6vw,5rem)] leading-none text-text/10 uppercase text-center">
                    {project.name}
                  </span>
                </div>

                {/* Número */}
                <div class="absolute top-6 left-6 micro text-muted">
                  {String(i + 1).padStart(2, "0")}
                </div>
              </a>
            </div>

            {/* Bloque texto */}
            <div
              class={`md:col-span-5 ${isEven ? "md:order-2" : "md:order-1"}`}
            >
              <span class="micro text-muted block mb-6">
                {String(i + 1).padStart(2, "0")} — {project.category}
              </span>

              <h3 class="font-display text-[clamp(2rem,5vw,4rem)] leading-none uppercase mb-6">
                <span class="mask-line">
                  <span class="reveal-line block">{project.name}</span>
                </span>
              </h3>

              <div class="flex items-center gap-6 mb-10">
                <span class="micro text-muted">{project.year}</span>
                <span class="w-1 h-1 rounded-full bg-accent" />
                <span class="micro text-muted">Madrid</span>
              </div>

              <a
                href={`/${lang}/work/${project.slug}`}
                class="group inline-flex items-center gap-3 micro hover:text-accent transition-colors"
              >
                <span>Ver proyecto</span>
                <span class="transition-transform group-hover:translate-x-1">
                  →
                </span>
              </a>
            </div>
          </div>
        </article>
      );
    })
  }

  {/* CTA al final */}
  <div class="px-6 md:px-10 pb-32 md:pb-48 flex justify-center" data-reveal>
    <a
      href={`/${lang}/work`}
      class="group inline-flex items-center gap-4 micro text-muted hover:text-accent transition-colors"
    >
      <span class="w-12 h-px bg-current transition-all group-hover:w-20"></span>
      <span>{t.work.seeAll}</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
