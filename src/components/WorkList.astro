---
import { getCopy } from "@/data/copy";

interface Props {
  lang?: string;
}
const lang = Astro.props.lang ?? "es";
const t = getCopy(lang);

const gradients = [
  "from-accent via-accent/40 to-accent2/60",
  "from-accent2 via-accent2/40 to-accent/60",
  "from-accent via-accent2/50 to-transparent",
  "from-accent2 via-accent/50 to-transparent",
  "from-accent via-transparent to-accent2",
  "from-accent2 via-transparent to-accent",
];
---

<section class="work-list relative px-6 md:px-10 pt-32 md:pt-48 pb-24 md:pb-32">
  {/* Header */}
  <div class="mb-16 md:mb-24 relative z-10">
    <div class="flex items-baseline gap-6 mb-8">
      <span class="micro text-muted" data-reveal>
        {t.work.index} — {t.work.label}
      </span>
      <span class="micro text-faint" data-reveal>
        ({t.work.projects.length})
      </span>
    </div>
    <h1
      class="font-display text-[clamp(3rem,11vw,10rem)] leading-none uppercase"
      data-reveal-lines
    >
      <span class="mask-line"
        ><span class="reveal-line block">{t.work.title}</span></span
      >
    </h1>
  </div>

  {/* Lista de proyectos */}
  <div class="work-items relative z-10" data-reveal-stagger>
    {
      t.work.projects.map((project, i) => (
        <a
          href={`/${lang}/work/${project.slug}`}
          class="work-item group grid grid-cols-12 gap-4 md:gap-8 items-baseline py-6 md:py-8 border-b border-border relative"
          data-work-item
          data-work-index={i}
          data-work-gradient={gradients[i % gradients.length]}
          data-work-name={project.name}
        >
          <span class="col-span-2 md:col-span-1 micro text-muted group-hover:text-accent transition-colors">
            {String(i + 1).padStart(2, "0")}
          </span>

          <h2 class="col-span-10 md:col-span-6 font-display text-[clamp(1.75rem,4.5vw,3.5rem)] leading-none uppercase group-hover:text-accent transition-colors">
            <span class="inline-block group-hover:translate-x-2 transition-transform duration-500 ease-out">
              {project.name}
            </span>
          </h2>

          <span class="col-span-6 md:col-span-3 micro text-muted">
            {project.category}
          </span>

          <div class="col-span-6 md:col-span-2 flex items-center justify-between md:justify-end gap-4">
            <span class="micro text-muted">{project.year}</span>
            <span class="micro text-muted group-hover:text-accent group-hover:translate-x-1 transition-all duration-300">
              →
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-16 md:mt-24 relative z-10" data-reveal>
    <a
      href={`/${lang}`}
      class="group inline-flex items-center gap-4 micro text-muted hover:text-accent transition-colors"
    >
      <span class="transition-transform group-hover:-translate-x-1">←</span>
      <span>Volver al inicio</span>
    </a>
  </div>
</section>

{/* Fondo fijo: gradiente + texto gigante — oculto por defecto */}
<div
  class="work-bg fixed inset-0 pointer-events-none z-0 flex items-center justify-center"
  style="opacity: 0;"
  data-work-bg
  aria-hidden="true"
>
  <div
    class="work-bg-blur absolute bg-gradient-to-br from-accent via-accent/40 to-accent2/60 blur-3xl"
    style="top: 15vh; left: 15vw; width: 70vw; height: 70vh; opacity: 0.35;"
    data-work-bg-blur
  >
  </div>

  <div
    class="work-bg-text relative font-display uppercase select-none"
    style="font-size: clamp(6rem, 16vw, 20rem); line-height: 0.85; letter-spacing: -0.03em; transform: rotate(-3deg);"
    data-work-bg-text
  >
  </div>
</div>
