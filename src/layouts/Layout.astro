---
import "@/styles/global.css";
import Preloader from "@/components/Preloader.astro";
import MobileMenu from "@/components/MobileMenu.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = "OTTRO.studio",
  description = "Desarrollo web y diseño de marca. Construyo productos digitales con criterio visual desde Madrid.",
  lang = "es",
} = Astro.props;
---

<!doctype html>
<html lang={lang} style="background:#0B1220; color:#F5F2ED;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph (Facebook, LinkedIn, WhatsApp, etc.) */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://ottro.studio/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ottro.studio/og-image.png" />

    {/* Favicon */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Preloader />
    <MobileMenu />
    <slot />

    <script>
      import "@/scripts/boot";
    </script>
  </body>
</html>
