<!doctype html>
<html lang="es" style="background:#0B1220;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>OTTRO.studio</title>
    <style is:inline>
      html,
      body {
        background: #0b1220;
        color: #f5f2ed;
        margin: 0;
        min-height: 100vh;
      }
    </style>
    <script is:inline>
      (function () {
        var userLang = (navigator.language || "es").toLowerCase();
        var target = userLang.startsWith("en") ? "/en" : "/es";
        window.location.replace(target);
      })();
    </script>
  </head>
  <body></body>
</html>
